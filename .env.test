# Build profile for environments driven by automation: `npm run build:test`.
#
# Everything here is a public constant, which is why this file is committed
# while .env.production is not. Vite loads .env then .env.test in this mode,
# so BOTH values must be restated - .env.production is not loaded, and the
# base .env carries the localhost dev API URL that would otherwise win.

# Same-origin: nginx serves the SPA and proxies /api.
VITE_API_URL=/api

# Cloudflare's always-passes test sitekey. Skips the hostname check, so
# automated browsers are never challenged. Pair with the matching test SECRET
# on the server - set-turnstile-mode.sh does both halves together.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
