# Build profile for a box with Turnstile switched off: `npm run build:off`, which is
# what deploy-aws.sh builds by default (TURNSTILE_MODE=off).
#
# Everything here is a public constant, which is why this file is committed. Vite
# loads .env then .env.off in this mode, so the API URL MUST be restated here: the
# base .env carries the localhost dev API URL, which would otherwise be baked into
# the bundle (deploy-aws.sh refuses to ship such a build).

# Same-origin: nginx serves the SPA and proxies /api.
VITE_API_URL=/api

# No sitekey: with Turnstile off there is no widget, and TurnstileWidget skips the check.
VITE_TURNSTILE_SITE_KEY=
